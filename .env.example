# Optional JSON array of browser-visible RTCIceServer objects.
# The defaults use STUN. Configure TURN for restrictive NAT/firewalls.
# Use browser-scoped, short-lived TURN credentials; never put backend secrets here.
# VITE_RTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-host:3478","username":"temporary-user","credential":"temporary-password"}]'

# all: prefer the best available direct or relay path (normal play).
# relay: require TURN; useful to prove that the relay actually works.
# Invalid explicit configuration fails visibly instead of silently using STUN.
# VITE_RTC_ICE_TRANSPORT_POLICY=all

# Local TURN lab: npm run turn:lab:start generates .env.turn-lab.local.
# npm run dev:netlab starts Vite in turn-lab mode; defaults stay unchanged.

# Optional self-hosted PeerJS signaling server (https://github.com/peers/peerjs-server).
# Without VITE_PEER_HOST the public PeerJS cloud is used. Signaling only brokers connections;
# a signaling outage does not interrupt matches already in progress.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# VITE_PEER_KEY=peerjs
