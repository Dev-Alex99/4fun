# Copy outside the repository, e.g. /etc/tp04-turn/server.env, and chmod 600.
# Replace every value before rendering. This is not an active deployment.
TURN_REALM=turn.example.com
TURN_PUBLIC_IP=REPLACE_WITH_REAL_PUBLIC_IPV4
TURN_LISTEN_IP=REPLACE_WITH_SERVER_INTERFACE_IPV4
TURN_SHARED_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TURN_CERT_FILE=/etc/letsencrypt/live/turn.example.com/fullchain.pem
TURN_KEY_FILE=/etc/letsencrypt/live/turn.example.com/privkey.pem
