# Production starting point. Render from a private server env file, never a VITE_* secret.
# Intended for one IPv4 relay interface; configure IPv6 separately if needed.
listening-port=3478
tls-listening-port=5349
listening-ip=${TURN_LISTEN_IP}
relay-ip=${TURN_LISTEN_IP}
external-ip=${TURN_PUBLIC_IP}/${TURN_LISTEN_IP}
realm=${TURN_REALM}
server-name=${TURN_REALM}
cert=${TURN_CERT_FILE}
pkey=${TURN_KEY_FILE}
fingerprint
use-auth-secret
static-auth-secret=${TURN_SHARED_SECRET}
stale-nonce=300
max-allocate-lifetime=3600
max-allocate-timeout=30
min-port=49160
max-port=49259
user-quota=8
total-quota=64
max-bps=2000000
bps-capacity=64000000
relay-threads=2
cli=false
web-admin=false
no-tcp-relay
no-multicast-peers
# Never enable allow-loopback-peers or server-relay on a public TURN service.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
log-file=stdout
simple-log
pidfile=/tmp/turnserver.pid
